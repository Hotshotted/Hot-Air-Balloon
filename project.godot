; Engine configuration file.
config_version=5

[application]

config/name="Wind Layers"
config/description="Wind Layers, a hot air balloon game by Clear Prop Games."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.0509804, 0.101961, 0.2, 1)
boot_splash/image="res://assets/splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=true

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"
general/default_playback_type.web=1

[autoload]

Tuning="*res://scripts/Tuning.gd"
Save="*res://scripts/Save.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.05, 0.08, 0.15, 1)
